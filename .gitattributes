# Keep Unix build/configuration files stable when Git for Windows has
# core.autocrlf enabled. This prevents harmless conversion warnings from
# being reported as staging failures by GUI clients.
.gitattributes text eol=lf
.github/** text eol=lf
**/Makefile text eol=lf
*.sh text eol=lf
External/mpv/patches/*.patch text eol=lf
External/servus/patches/*.patch text eol=lf whitespace=-blank-at-eol
External/servus/source/** text eol=lf
External/servus/source/servus/md5/README whitespace=-blank-at-eol,-blank-at-eof
*.yml text eol=lf
*.yaml text eol=lf
*.pbxproj text eol=lf
*.c text eol=lf
*.md text eol=lf
JuceLibraryCode/JuceHeader.h text eol=lf
